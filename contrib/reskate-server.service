[Unit]
Description=ReSkate dedicated server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=reskate
WorkingDirectory=/opt/reskate-server
ExecStart=/opt/reskate-server/ReSkateServer
Restart=always
RestartSec=5
# The server updates itself in place (the new version takes over this same process), so
# its user must be able to write to WorkingDirectory. Any exit still restarts it here.
# The server already appends every line to ReSkateServer.log next to itself;
# appending stdout there too wrote each line twice. The journal keeps the console copy.
StandardOutput=journal
StandardError=inherit

[Install]
WantedBy=multi-user.target
