# Shared by the native runtime build and the standalone BMX development harness.
function(dingosdk_add_bmx_tests source_root)
    include("${source_root}/cmake/BmxStandalone.cmake")
    if(DINGOSDK_BMX_STANDALONE_MOVEMENT AND DINGOSDK_BMX_NATIVE_COUPLED)
        dingosdk_require_bmx_movement("${source_root}")
        add_executable(dingosdk_bmx_coupled_ride_frame_tests "${source_root}/Extension/BMX/Test/bmx_coupled_ride_frame_tests.cpp")
        target_compile_features(dingosdk_bmx_coupled_ride_frame_tests PRIVATE cxx_std_20)
        target_include_directories(dingosdk_bmx_coupled_ride_frame_tests PRIVATE "${source_root}")
        target_link_libraries(dingosdk_bmx_coupled_ride_frame_tests PRIVATE bmx::movement)
        add_test(NAME bmx_coupled_ride_frame COMMAND dingosdk_bmx_coupled_ride_frame_tests)
    endif()
    if(DINGOSDK_BMX_STANDALONE_MOVEMENT)
        dingosdk_require_bmx_movement("${source_root}")
        add_executable(dingosdk_bmx_standalone_shadow_tests "${source_root}/Extension/BMX/Test/bmx_standalone_shadow_tests.cpp")
        target_compile_features(dingosdk_bmx_standalone_shadow_tests PRIVATE cxx_std_20)
        target_include_directories(dingosdk_bmx_standalone_shadow_tests PRIVATE "${source_root}")
        target_link_libraries(dingosdk_bmx_standalone_shadow_tests PRIVATE bmx::movement)
        add_test(NAME bmx_standalone_shadow COMMAND dingosdk_bmx_standalone_shadow_tests)
        if(EXISTS "${source_root}/Extension/BMX/Test/bmx_observed_posture_tests.cpp")
            add_executable(dingosdk_bmx_observed_posture_tests "${source_root}/Extension/BMX/Test/bmx_observed_posture_tests.cpp")
            target_compile_features(dingosdk_bmx_observed_posture_tests PRIVATE cxx_std_20)
            target_compile_definitions(dingosdk_bmx_observed_posture_tests PRIVATE DINGOSDK_BMX_STANDALONE_MOVEMENT=1)
            target_include_directories(dingosdk_bmx_observed_posture_tests PRIVATE "${source_root}")
            target_link_libraries(dingosdk_bmx_observed_posture_tests PRIVATE bmx::movement)
            add_test(NAME bmx_observed_posture COMMAND dingosdk_bmx_observed_posture_tests)
        endif()
    endif()
    add_executable(dingosdk_bmx_coupled_pose_debug_tests "${source_root}/Engine/Game/BMX/Test/bmx_coupled_pose_debug_tests.cpp")
    target_compile_features(dingosdk_bmx_coupled_pose_debug_tests PRIVATE cxx_std_20)
    target_include_directories(dingosdk_bmx_coupled_pose_debug_tests PRIVATE "${source_root}")
    if(TARGET dingosdk_json)
        target_link_libraries(dingosdk_bmx_coupled_pose_debug_tests PRIVATE dingosdk_json)
    else()
        add_library(dingosdk_bmx_pose_debug_json STATIC "${source_root}/Engine/Core/Json/json.cpp")
        target_compile_features(dingosdk_bmx_pose_debug_json PRIVATE cxx_std_20)
        target_include_directories(dingosdk_bmx_pose_debug_json SYSTEM PRIVATE "${source_root}/External")
        target_link_libraries(dingosdk_bmx_coupled_pose_debug_tests PRIVATE dingosdk_bmx_pose_debug_json)
    endif()
    add_test(NAME bmx_coupled_pose_debug COMMAND dingosdk_bmx_coupled_pose_debug_tests)
    add_executable(dingosdk_bmx_skeleton_phase_policy_tests "${source_root}/Engine/Game/BMX/Test/bmx_skeleton_phase_policy_tests.cpp")
