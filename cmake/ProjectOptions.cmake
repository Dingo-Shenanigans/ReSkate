
set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)
if(MSVC)
    set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
endif()
set_property(GLOBAL PROPERTY USE_FOLDERS ON)

# Windows version information (Explorer's Details tab) for the shipped binaries. A release is
# named by an eight digit build number, the day of the commit it was built from (20261114), which
# the release script works out and passes; local builds say 00000000.
set(DINGOSDK_VERSION "00000000" CACHE STRING "Release build number (eight digits, YYYYMMDD) stamped into the shipped binaries")
# A build folder configured when releases were numbered 1.2.3 still holds that default.
if(DINGOSDK_VERSION STREQUAL "0.0.0")
    set_property(CACHE DINGOSDK_VERSION PROPERTY VALUE "00000000")
endif()
if(NOT DINGOSDK_VERSION MATCHES "^([0-9][0-9][0-9][0-9])([0-9][0-9])([0-9][0-9])$")
    message(FATAL_ERROR "DINGOSDK_VERSION must be an eight digit build number like 20261114, not '${DINGOSDK_VERSION}'")
endif()
# Windows keeps a file's version as four 16 bit numbers, none of which holds a build number:
# its year, month and day are the first three (without leading zeros, which a resource reads as octal).
set(reskate_version_year "${CMAKE_MATCH_1}")
set(reskate_version_month "${CMAKE_MATCH_2}")
set(reskate_version_day "${CMAKE_MATCH_3}")
foreach(part year month day)
    string(REGEX REPLACE "^0+([0-9]+)$" "\\1" reskate_version_${part} "${reskate_version_${part}}")
endforeach()
# Set by a modified build (a mod that replaces ReSkate.dll) so it is never mistaken for ReSkate itself.
set(DINGOSDK_MOD_ID "" CACHE STRING "Name of the mod this build carries (letters, digits, underscores); empty for ReSkate itself")
set(DINGOSDK_MOD_VERSION "" CACHE STRING "Version of that mod")
if(DINGOSDK_MOD_ID AND NOT DINGOSDK_MOD_ID MATCHES "^[A-Za-z0-9_]+$")
    message(FATAL_ERROR "DINGOSDK_MOD_ID may only use letters, digits and underscores")
endif()
if(DINGOSDK_MOD_VERSION AND NOT DINGOSDK_MOD_VERSION MATCHES "^[0-9A-Za-z._+-]+$")
    message(FATAL_ERROR "DINGOSDK_MOD_VERSION may only use letters, digits and . _ + -")
endif()
# Research tools (the throwdown lab's console verbs, `ui dump`, `capture depth`, the memory
# ledger's owner tracing, the trainer's self test, dumps and telemetry) are compiled in only
# when this is on: releases leave it off, so ReSkate.dll does not carry them.
option(DINGOSDK_DEV_TOOLS "Compile ReSkate's research tools into ReSkate.dll (development builds only)" OFF)
if(DINGOSDK_DEV_TOOLS)
    add_compile_definitions(DINGOSDK_DEV_TOOLS)
endif()
# The same version for code to show (generated/reskate_version.h).
string(REPLACE "\\" "\\\\" reskate_version_escaped "${DINGOSDK_VERSION}")
string(REPLACE "\"" "\\\"" reskate_version_escaped "${reskate_version_escaped}")
configure_file("${PROJECT_SOURCE_DIR}/cmake/templates/reskate_version.h.in"
    "${CMAKE_CURRENT_BINARY_DIR}/generated/reskate_version.h" @ONLY)
function(dingosdk_version_info target description file_name file_type)
    if(NOT WIN32)
        return()
    endif()
    set(version_major ${reskate_version_year})
    set(version_minor ${reskate_version_month})
    set(version_patch ${reskate_version_day})
    set(version_description "${description}")
    set(version_file_name "${file_name}")
    set(version_file_type "${file_type}")
    get_filename_component(version_internal_name "${file_name}" NAME_WE)
    configure_file("${PROJECT_SOURCE_DIR}/cmake/templates/version.rc.in"
        "${CMAKE_CURRENT_BINARY_DIR}/generated/${target}_version.rc" @ONLY)
    target_sources(${target} PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/generated/${target}_version.rc")
endfunction()

function(dingosdk_configure_target target)
    target_include_directories(${target} PUBLIC "${PROJECT_SOURCE_DIR}" "${CMAKE_CURRENT_BINARY_DIR}/generated")
    if(WIN32)
        target_compile_definitions(${target} PRIVATE WIN32_LEAN_AND_MEAN NOMINMAX UNICODE _UNICODE)
    endif()
    if(MSVC)
        target_compile_options(${target} PRIVATE /W4 /WX /MP /permissive- /EHsc)
    else()
        target_compile_options(${target} PRIVATE -Wall -Wextra -Wno-missing-field-initializers -Wno-unused-function -Wno-array-bounds)
    endif()
    if(target STREQUAL "dingosdk_launcher")
        set_property(TARGET ${target} PROPERTY FOLDER "Apps")
    elseif(target MATCHES "^dingosdk_runtime$")
        set_property(TARGET ${target} PROPERTY FOLDER "Runtime")
    elseif(target MATCHES "^dingosdk_(hooks|json|storage|console_core|logging|initfs|native_db|mods|frostbite)$")
        set_property(TARGET ${target} PROPERTY FOLDER "Core")
    else()
        set_property(TARGET ${target} PROPERTY FOLDER "Components")
    endif()
    # Show headers beside implementation files in each target's source folders.
    get_target_property(sources ${target} SOURCES)
    if(sources)
        set(source_directories)
        foreach(source IN LISTS sources)
            get_filename_component(source_path "${source}" ABSOLUTE BASE_DIR "${PROJECT_SOURCE_DIR}")
            get_filename_component(source_directory "${source_path}" DIRECTORY)
            list(APPEND source_directories "${source_directory}")
        endforeach()
        list(REMOVE_DUPLICATES source_directories)
        foreach(directory IN LISTS source_directories)
            file(GLOB adjacent_headers CONFIGURE_DEPENDS "${directory}/*.h")
            if(adjacent_headers)
                target_sources(${target} PRIVATE ${adjacent_headers})
            endif()
        endforeach()
        get_target_property(sources ${target} SOURCES)
        # External build products and generator expressions use default groups.
        set(source_tree_sources)
        foreach(source IN LISTS sources)
            if(source MATCHES "\\$<")
                continue()
            endif()
            get_filename_component(source_path "${source}" ABSOLUTE BASE_DIR "${PROJECT_SOURCE_DIR}")
            cmake_path(IS_PREFIX PROJECT_SOURCE_DIR "${source_path}" NORMALIZE in_source_tree)
            if(in_source_tree)
                list(APPEND source_tree_sources "${source_path}")
            endif()
        endforeach()
        if(source_tree_sources)
            source_group(TREE "${PROJECT_SOURCE_DIR}" FILES ${source_tree_sources})
        endif()
    endif()
endfunction()

set(DINGOSDK_TEST_GAME_ROOT "" CACHE PATH "Optional Skate folder for tests that read the installed game's data")
