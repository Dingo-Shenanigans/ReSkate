{
  "version": 3,
  "configurePresets": [
    {
      "name": "vs2022-x64",
      "displayName": "Visual Studio 2022 x64",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/vs2022-x64",
      "environment": {
        "VCLibPackagePath": "${sourceDir}/build/no-vcpkg/vcpkg.user"
      },
      "toolset": "v143"
    },
    {
      "name": "vs2022-x64-dev",
      "displayName": "Visual Studio 2022 x64, with the research tools (development only)",
      "inherits": "vs2022-x64",
      "binaryDir": "${sourceDir}/build/vs2022-x64-dev",
      "cacheVariables": {
        "DINGOSDK_DEV_TOOLS": "ON"
      }
    },
    {
      "name": "linux-x64",
      "displayName": "Linux x64 (dedicated server only)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "vs2022-x64",
      "configuration": "Release"
    },
    {
      "name": "dev-release",
      "configurePreset": "vs2022-x64-dev",
      "configuration": "Release"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-x64"
    }
  ]
}
